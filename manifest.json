{
  "manifest_version": 3,
  "name": "DualBlock",
  "short_name": "DualBlock",
  "version": "1.0.0",
  "description": "Evita abrir pestañas duplicadas en cualquier sitio web, previniendo conflictos de sesión y datos.",

  "permissions": [
    "tabs",          
    "storage",       
    "notifications", 
    "windows"        
  ],

  "background": {
    "service_worker": "background.js"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "DualBlock — Abrir configuración"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "32":  "icons/icon32.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
